# Credential-bearing files (audited 2026-09-14: `.env` and `.env.*` were covered
# but the `*.env` suffix form was not — and scripts/deploy.sh itself creates
# shared/executor.env, which holds AEGIS_EXECUTOR_TOKEN).
*.env
!.env.example
*.pem
id_ed25519*
id_rsa*
credentials.json
auth.json
service-account*.json

# Machine-specific build tuning; see .cargo/config.toml.example
.cargo/config.toml

# Author-local Claude Code config: hooks, commands, coordination notes, agent memory.
# Personal working material, not part of the product; see CONTRIBUTING.md.
.claude/

