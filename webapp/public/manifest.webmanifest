{
  "name": "Aegis Private Secretary",
  "short_name": "Aegis",
  "description": "Owner-only Aegis command, work, status, and settings surface.",
  "id": "/ui/",
  "start_url": "/ui/",
  "scope": "/ui/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "browser"
  ],
  "orientation": "portrait-primary",
  "background_color": "#f3f4f6",
  "theme_color": "#f3f4f6",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/ui/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/ui/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/ui/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Aegis",
      "short_name": "Aegis",
      "url": "/ui/",
      "description": "Open the chat home."
    },
    {
      "name": "Work",
      "short_name": "Work",
      "url": "/ui/?view=work",
      "description": "Open owner work."
    },
    {
      "name": "Status",
      "short_name": "Status",
      "url": "/ui/?view=status",
      "description": "Open assistant status."
    }
  ]
}
